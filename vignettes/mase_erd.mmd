%%{init: {'theme':'base', 'themeVariables': { 'fontSize': '13px' }}}%%

%% Entities are declared in the order the Introduction vignette describes them:
%% first the MultiAssayExperiment core that MASE inherits (tan), then the
%% spatial element layers MASE adds (blue), then the two tables that map
%% observations onto specimens and onto space. Every entity label here appears
%% verbatim in that description.

erDiagram
    %% ---- 1. Inherited from MultiAssayExperiment ----
    colData["colData(mase)"] {
        string rowname PK "specimen identifier"
        string tissue "specimen metadata"
        string condition "specimen metadata"
    }

    experiments["experiments(mase) (ExperimentList)"] {
        string name PK "assay name"
        Experiment experiment "one element per assay"
    }

    Experiment["Experiment (SummarizedExperiment)"] {
        string rowname PK "feature name"
        string colname PK "observation name"
        Matrix-like assay "assay data"
        DataFrame rowData "feature metadata"
        DataFrame colData "observation metadata"
    }

    sampleMap["sampleMap(mase)"] {
        string assay FK "assay name"
        string primary FK "specimen identifier"
        string colname FK "column in the assay matrix"
    }

    %% ---- 2. Spatial element layers added by MASE ----
    spatialPoints["spatialPoints(mase)"] {
        string name PK "points layer name"
        PointsLayer layer "one element per layer"
    }

    PointsLayer["points layer (DataFrame)"] {
        string instance_id PK "spatial element"
        float x "coordinate"
        float y "coordinate"
        string cell_type "element metadata"
    }

    spatialShapes["spatialShapes(mase)"] {
        string name PK "shapes layer name"
        ShapesLayer layer "one element per layer"
    }

    ShapesLayer["shapes layer (DataFrame)"] {
        string instance_id PK "spatial element"
        geometry geometry "sf geometry column"
        float area "element metadata"
    }

    spatialImages["spatialImages(mase)"] {
        string name PK "image layer name"
        Raster raster "tissue image"
    }

    spatialLabels["spatialLabels(mase)"] {
        string name PK "label layer name"
        Raster raster "segmentation mask"
    }

    %% ---- 3. Tables mapping observations to specimens and to space ----
    spatialMap["spatialMap(mase)"] {
        string assay FK "assay name"
        string colname FK "column in the assay matrix"
        enum element_type "'points' or 'shapes'"
        string region FK "spatial layer name"
        string instance_id FK "spatial element"
    }

    imgData["imgData(mase)"] {
        string sample_id FK "specimen identifier"
        string image_id "image layer name"
        float scaleFactor "pixels to spatial units"
    }

    %% ---- Relationships ----
    colData ||--o{ sampleMap : "primary"
    experiments ||--|| Experiment : "name"
    experiments ||--o{ sampleMap : "assay"
    sampleMap }o--|| Experiment : "assay,colname"

    spatialPoints ||--|| PointsLayer : "name"
    spatialShapes ||--|| ShapesLayer : "name"

    sampleMap ||--o{ spatialMap : "assay,colname"
    spatialMap }o--|| spatialPoints : "element_type,region"
    spatialMap }o--|| spatialShapes : "element_type,region"
    PointsLayer ||--o{ spatialMap : "instance_id"
    ShapesLayer ||--o{ spatialMap : "instance_id"

    colData ||--o{ imgData : "rowname"
    imgData }o--|| spatialImages : "image_id"
    imgData }o--o| spatialLabels : "image_id"

    %% ---- Colours: tan = inherited from MultiAssayExperiment, blue = MASE ----
    style colData fill:#e8d5b7,stroke:#7f6a4d
    style experiments fill:#e8d5b7,stroke:#7f6a4d
    style Experiment fill:#e8d5b7,stroke:#7f6a4d
    style sampleMap fill:#e8d5b7,stroke:#7f6a4d

    style spatialPoints fill:#9fc5e8,stroke:#3d6b93
    style PointsLayer fill:#9fc5e8,stroke:#3d6b93
    style spatialShapes fill:#9fc5e8,stroke:#3d6b93
    style ShapesLayer fill:#9fc5e8,stroke:#3d6b93
    style spatialImages fill:#9fc5e8,stroke:#3d6b93
    style spatialLabels fill:#9fc5e8,stroke:#3d6b93
    style spatialMap fill:#9fc5e8,stroke:#3d6b93
    style imgData fill:#9fc5e8,stroke:#3d6b93
